{
  "name": "copilot-maturity-dashboard",
  "version": "1.0.0",
  "private": true,
  "description": "White-label GitHub Copilot token consumption & maturity dashboard per team (enterprise or organization scope).",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "configure": "tsx scripts/configure.ts",
    "auth:check": "tsx scripts/check-auth.ts",
    "probe": "tsx scripts/probe-api.ts",
    "collect": "tsx scripts/collect/index.ts",
    "aggregate": "tsx scripts/build/index.ts",
    "dev": "vite",
    "build:site": "vite build",
    "build": "npm run aggregate && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "testdata:generate": "tsx scripts/testdata/generate.ts",
    "testdata:collect": "tsx scripts/testdata/run-pipeline.ts collect",
    "testdata:build": "tsx scripts/testdata/run-pipeline.ts build",
    "testdata:dev": "tsx scripts/testdata/run-pipeline.ts dev",
    "testdata": "tsx scripts/testdata/run-pipeline.ts all"
  },
  "dependencies": {
    "@octokit/auth-app": "^8.3.1",
    "@octokit/request": "^10.0.16",
    "d3": "^7.9.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@primer/css": "^22.3.2",
    "@types/d3": "^7.4.3",
    "@types/node": "^26.6.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
